local title = Instance.new("TextLabel")
title.BackgroundTransparency = 1
title.Size = UDim2.new(0.5,0,0.12,0)
title.Position = UDim2.new(0.09,0,0.29,0)
title.Text = "RIFT PROTOCOL"
